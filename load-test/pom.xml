<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>dev.rgonz.payments</groupId>
		<artifactId>b2b-payments-platform</artifactId>
		<version>0.0.1-SNAPSHOT</version>
	</parent>
	<artifactId>load-test</artifactId>
	<name>load-test</name>
	<description>The Gatling simulations: the Network's Authorize over gRPC, and an ERP's Invoices over HTTP. No main code.</description>

	<properties>
		<gatling.version>3.16.0</gatling.version>
		<!-- What the simulator's POST /demo/load-test-cards writes; -DcardsFile=… charges another file. -->
		<cardsFile>${project.basedir}/../var/load-test/cards.csv</cardsFile>
		<!-- The simulation a run starts; -Dsimulation=dev.rgonz.payments.loadtest.InvoiceSimulation runs the other. -->
		<simulation>dev.rgonz.payments.loadtest.AuthorizeSimulation</simulation>
		<!-- The versions Gatling 3.16.0 is built against: Spring Boot's dependency management would
		     otherwise hand it older ones. Only this module; the contracts' generated code runs on newer
		     protobuf and grpc-java runtimes. Update with Gatling. -->
		<netty.version>4.2.18.Final</netty.version>
		<grpc-java.version>1.84.0</grpc-java.version>
		<protobuf-java.version>4.36.2</protobuf-java.version>
	</properties>

	<dependencies>
		<dependency>
			<groupId>dev.rgonz.payments</groupId>
			<artifactId>contracts</artifactId>
			<version>${project.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>io.gatling.highcharts</groupId>
			<artifactId>gatling-charts-highcharts</artifactId>
			<version>${gatling.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>io.gatling</groupId>
			<artifactId>gatling-grpc-java</artifactId>
			<version>${gatling.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>io.gatling</groupId>
			<artifactId>gatling-http-java</artifactId>
			<version>${gatling.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<profiles>
		<!-- The run itself, by hand against the Docker Compose stack (README): `./mvnw -B -pl load-test -am
		     -Pload-test verify`. Without the profile, `verify` (and so CI) only compiles the simulation and runs
		     its unit tests: CI's shared runners make a p99 meaningless. -->
		<profile>
			<id>load-test</id>
			<build>
				<plugins>
					<plugin>
						<groupId>io.gatling</groupId>
						<artifactId>gatling-maven-plugin</artifactId>
						<version>4.21.12</version>
						<configuration>
							<simulationClass>${simulation}</simulationClass>
							<jvmArgs>
								<jvmArg>-DcardsFile=${cardsFile}</jvmArg>
							</jvmArgs>
						</configuration>
						<executions>
							<execution>
								<goals>
									<goal>test</goal>
								</goals>
								<phase>integration-test</phase>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
