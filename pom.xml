<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.2</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>dev.rgonz.payments</groupId>
	<artifactId>b2b-payments-platform</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>b2b-payments-platform</name>
	<description/>
	<url/>
	<!-- Empty overrides stop Spring Boot's own project metadata being inherited. -->
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>

	<modules>
		<module>contracts</module>
		<!-- Before the platform: its consumer tests write the pact the platform's provider test verifies. It verifies the
		     platform's pact as committed, and CI checks that the platform's build leaves that file unchanged. -->
		<module>authorization-service</module>
		<module>vault-service</module>
		<module>platform</module>
		<module>simulator</module>
		<module>gateway</module>
		<module>e2e</module>
		<module>load-test</module>
	</modules>

	<properties>
		<java.version>25</java.version>
		<pact.version>4.7.5</pact.version>
		<resilience4j.version>2.4.0</resilience4j.version>
		<!-- Only the apps run: `./mvnw -pl platform -am spring-boot:run` builds contracts on the way. -->
		<spring-boot.run.skip>true</spring-boot.run.skip>
		<!-- Likewise only the apps get an image (`spring-boot:build-image`, M6): b2b-payments/<module>:local, which
		     scripts/k3d-cluster.sh imports into the cluster. -->
		<spring-boot.build-image.skip>true</spring-boot.build-image.skip>
		<spring-boot.build-image.imageName>b2b-payments/${project.artifactId}:local</spring-boot.build-image.imageName>
		<sonar.organization>rgonzal92</sonar.organization>
		<sonar.projectKey>rgonzal92_b2b-payments-platform</sonar.projectKey>
		<sonar.host.url>https://sonarcloud.io</sonar.host.url>
		<!-- shortcut: vault-service ports the platform's vault (Pans), which M7's last ticket deletes with the vault schema; drop this then. -->
		<sonar.cpd.exclusions>**/payments/platform/vault/**</sonar.cpd.exclusions>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>io.opentelemetry.instrumentation</groupId>
				<artifactId>opentelemetry-logback-appender-1.0</artifactId>
				<!-- Built against OpenTelemetry API 1.62.0, the version Spring Boot 4.1.1 manages. -->
				<version>2.28.0-alpha</version>
			</dependency>
			<dependency>
				<groupId>com.github.dasniko</groupId>
				<artifactId>testcontainers-keycloak</artifactId>
				<!-- Built for Testcontainers 2.0.5 and Keycloak 26.8, as used here. -->
				<version>4.4.0</version>
			</dependency>
			<!-- Pact JVM's message pacts (M5): each app has consumer tests for the topic it reads and a
			     provider test for the topic it writes. 4.7.5 is tested up to Java 23; #88 proved it on Java 25
			     (docs/learning/pact.md). Its Kotlin standard library is Spring Boot's, 2.3.21. -->
			<dependency>
				<groupId>au.com.dius.pact.consumer</groupId>
				<artifactId>junit5</artifactId>
				<version>${pact.version}</version>
			</dependency>
			<dependency>
				<groupId>au.com.dius.pact.provider</groupId>
				<artifactId>junit5</artifactId>
				<version>${pact.version}</version>
			</dependency>
			<!-- Resilience4j (M5, #93): the service's circuit breaker and time limiter around its database. 2.4.0 is the
			     first release with a Spring Boot 4 starter; the BOM pins its modules (Reactor, Micrometer) to the same
			     version, but doesn't list the Boot 4 starter. -->
			<dependency>
				<groupId>io.github.resilience4j</groupId>
				<artifactId>resilience4j-bom</artifactId>
				<version>${resilience4j.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>io.github.resilience4j</groupId>
				<artifactId>resilience4j-spring-boot4</artifactId>
				<version>${resilience4j.version}</version>
			</dependency>
			<!-- Spring Cloud (M6, #113): the gateway's Spring Cloud Gateway. Release train 2025.1.x (Oakwood) supports
			     Spring Boot 4.0.x and, from 2025.1.2, 4.1.x (spring.io/projects/spring-cloud's compatibility table;
			     start.spring.io gives 2025.1.3 for Boot >=4.0.0 and <4.2.0-M1); 2026.0.x is for Boot 4.2. #113 proved
			     2025.1.3 (Gateway 5.0.3) on Boot 4.1.1 with the gateway's tests (docs/learning/spring-cloud-gateway.md).
			     Imported last, so the Resilience4j BOM above keeps its pins over the train's circuit-breaker ones. -->
			<dependency>
				<groupId>org.springframework.cloud</groupId>
				<artifactId>spring-cloud-dependencies</artifactId>
				<version>2025.1.4</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<pluginManagement>
			<plugins>
				<!-- CI runs it by its full name, outside any phase: this pins the version that call uses. -->
				<plugin>
					<groupId>org.sonarsource.scanner.maven</groupId>
					<artifactId>sonar-maven-plugin</artifactId>
					<version>5.8.0.7211</version>
				</plugin>
			</plugins>
		</pluginManagement>
		<plugins>
			<plugin>
				<groupId>com.diffplug.spotless</groupId>
				<artifactId>spotless-maven-plugin</artifactId>
				<version>3.10.4</version>
				<configuration>
					<java>
						<googleJavaFormat>
							<!-- 1.37.0 fails under Spotless 3.10.4 with an InvocationTargetException. -->
							<version>1.36.1</version>
						</googleJavaFormat>
					</java>
				</configuration>
				<executions>
					<execution>
						<id>java-format-check</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>0.8.16</version>
				<executions>
					<execution>
						<id>prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>report</id>
						<phase>test</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
