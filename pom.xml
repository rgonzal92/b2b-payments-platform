<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>dev.rgonz.payments</groupId>
	<artifactId>b2b-payments-platform</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>b2b-payments-platform</name>
	<description/>
	<url/>
	<!-- Empty overrides stop Spring Boot's own project metadata being inherited. -->
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>

	<modules>
		<module>contracts</module>
		<module>platform</module>
		<module>simulator</module>
	</modules>

	<properties>
		<java.version>25</java.version>
		<!-- Only the apps run: `./mvnw -pl platform -am spring-boot:run` builds contracts on the way. -->
		<spring-boot.run.skip>true</spring-boot.run.skip>
		<sonar.organization>rgonzal92</sonar.organization>
		<sonar.projectKey>rgonzal92_b2b-payments-platform</sonar.projectKey>
		<sonar.host.url>https://sonarcloud.io</sonar.host.url>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>io.opentelemetry.instrumentation</groupId>
				<artifactId>opentelemetry-logback-appender-1.0</artifactId>
				<!-- Built against OpenTelemetry API 1.62.0, the version Spring Boot 4.1.1 manages. -->
				<version>2.28.0-alpha</version>
			</dependency>
			<dependency>
				<groupId>com.github.dasniko</groupId>
				<artifactId>testcontainers-keycloak</artifactId>
				<!-- Built for Testcontainers 2.0.5 and Keycloak 26.8, as used here. -->
				<version>4.4.0</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<pluginManagement>
			<plugins>
				<!-- CI runs it by its full name, outside any phase: this pins the version that call uses. -->
				<plugin>
					<groupId>org.sonarsource.scanner.maven</groupId>
					<artifactId>sonar-maven-plugin</artifactId>
					<version>5.8.0.7211</version>
				</plugin>
			</plugins>
		</pluginManagement>
		<plugins>
			<plugin>
				<groupId>com.diffplug.spotless</groupId>
				<artifactId>spotless-maven-plugin</artifactId>
				<version>3.10.4</version>
				<configuration>
					<java>
						<googleJavaFormat>
							<!-- 1.37.0 fails under Spotless 3.10.4 with an InvocationTargetException. -->
							<version>1.36.1</version>
						</googleJavaFormat>
					</java>
				</configuration>
				<executions>
					<execution>
						<id>java-format-check</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>0.8.15</version>
				<executions>
					<execution>
						<id>prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>report</id>
						<phase>test</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
