<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>dev.rgonz.payments</groupId>
		<artifactId>b2b-payments-platform</artifactId>
		<version>0.0.1-SNAPSHOT</version>
	</parent>
	<artifactId>contracts</artifactId>
	<name>contracts</name>
	<description>The platform's API contracts (OpenAPI and protobuf), and the code generated from them.</description>

	<dependencies>
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-context</artifactId>
		</dependency>
		<dependency>
			<groupId>jakarta.validation</groupId>
			<artifactId>jakarta.validation-api</artifactId>
		</dependency>
		<dependency>
			<groupId>jakarta.annotation</groupId>
			<artifactId>jakarta.annotation-api</artifactId>
		</dependency>
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-annotations</artifactId>
		</dependency>
		<!-- What the code generated from src/main/proto needs: protobuf messages and grpc-java stubs. -->
		<dependency>
			<groupId>io.grpc</groupId>
			<artifactId>grpc-protobuf</artifactId>
		</dependency>
		<dependency>
			<groupId>io.grpc</groupId>
			<artifactId>grpc-stub</artifactId>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- The Network link's contract (src/main/proto): Spring Boot's parent sets the protoc and
			     grpc-java versions and the generate goal. -->
			<plugin>
				<groupId>io.github.ascopes</groupId>
				<artifactId>protobuf-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.openapitools</groupId>
				<artifactId>openapi-generator-maven-plugin</artifactId>
				<version>7.26.0</version>
				<!-- Settings both executions share; each execution adds its own. -->
				<configuration>
					<inputSpec>${project.basedir}/src/main/resources/openapi/platform-api.yaml</inputSpec>
					<generatorName>spring</generatorName>
					<generateSupportingFiles>false</generateSupportingFiles>
					<configOptions>
						<useSpringBoot4>true</useSpringBoot4>
						<useJackson3>true</useJackson3>
						<useTags>true</useTags>
						<openApiNullable>false</openApiNullable>
						<documentationProvider>none</documentationProvider>
						<annotationLibrary>none</annotationLibrary>
					</configOptions>
				</configuration>
				<executions>
					<execution>
						<id>platform-server</id>
						<goals>
							<goal>generate</goal>
						</goals>
						<configuration>
							<library>spring-boot</library>
							<apiPackage>dev.rgonz.payments.contracts.server</apiPackage>
							<modelPackage>dev.rgonz.payments.contracts.server.model</modelPackage>
							<!-- BuyerDto, not Buyer: the platform's own domain types keep the glossary names. -->
							<modelNameSuffix>Dto</modelNameSuffix>
							<configOptions>
								<interfaceOnly>true</interfaceOnly>
								<skipDefaultInterface>true</skipDefaultInterface>
								<useBeanValidation>true</useBeanValidation>
							</configOptions>
						</configuration>
					</execution>
					<execution>
						<id>simulator-client</id>
						<goals>
							<goal>generate</goal>
						</goals>
						<configuration>
							<library>spring-http-interface</library>
							<apiPackage>dev.rgonz.payments.contracts.client</apiPackage>
							<modelPackage>dev.rgonz.payments.contracts.client.model</modelPackage>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
