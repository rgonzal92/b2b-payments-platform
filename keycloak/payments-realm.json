{
  "realm": "payments",
  "enabled": true,
  "roles": {
    "realm": [
      { "name": "approver", "description": "A Buyer's employee who approves or rejects Invoices" },
      { "name": "erp", "description": "A Buyer's ERP, signing in as a machine" },
      { "name": "issuer-admin", "description": "Issuer staff" }
    ]
  },
  "clients": [
    {
      "clientId": "simulator-issuer-admin",
      "description": "The simulator acting as Issuer staff",
      "enabled": true,
      "publicClient": false,
      "secret": "${SIMULATOR_ISSUER_ADMIN_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocolMappers": [
        {
          "name": "realm roles as roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "acme-erp",
      "description": "Acme's ERP, played by the simulator",
      "enabled": true,
      "publicClient": false,
      "secret": "${ACME_ERP_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocolMappers": [
        {
          "name": "realm roles as roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "Acme as buyer_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "buyer_id",
            "claim.value": "dc9a9857-e40f-4d50-9ee3-879f0c7472c5",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-simulator-issuer-admin",
      "enabled": true,
      "serviceAccountClientId": "simulator-issuer-admin",
      "realmRoles": ["issuer-admin"]
    },
    {
      "username": "service-account-acme-erp",
      "enabled": true,
      "serviceAccountClientId": "acme-erp",
      "realmRoles": ["erp"]
    }
  ]
}
