{
  "uid": "payments",
  "title": "Payments",
  "description": "The Payment saga (ADR-0013, ADR-0014): the states Payments reach, and how long each step takes to run.",
  "tags": [
    "b2b-payments"
  ],
  "editable": true,
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "panels": [
    {
      "id": 1,
      "type": "bargauge",
      "title": "Payments reaching each state in the time range",
      "description": "How many Payments reached each saga state over the dashboard's time range. STARTED counts new Payments; FAILED and EXPIRED are the ones that ended without paying the Supplier.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (state) (round(increase(payments_state_changes_total[$__range])))",
          "legendFormat": "{{state}}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Payments reaching each state per minute",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "60 * sum by (state) (rate(payments_state_changes_total[$__rate_interval]))",
          "legendFormat": "{{state}}",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Step duration, average",
      "description": "How long each step took to run, failed attempts included. It doesn't count the time a Payment waits for the worker (every second) or for a retry's backoff.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (step) (rate(payments_steps_milliseconds_sum[$__rate_interval])) / sum by (step) (rate(payments_steps_milliseconds_count[$__rate_interval]))",
          "legendFormat": "{{step}}",
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Step duration, p95",
      "description": "The 95th percentile of each step's duration. Delivering the Remittance Advice waits on the Supplier, up to the 5-second read timeout.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (step, le) (rate(payments_steps_milliseconds_bucket[$__rate_interval])))",
          "legendFormat": "{{step}}",
          "range": true
        }
      ]
    }
  ]
}
