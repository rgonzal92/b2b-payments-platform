{
  "uid": "breaks",
  "title": "Breaks",
  "description": "The Breaks Reconciliation raised that no Reconciler has resolved yet: how many, of which kind, and how long ago they were raised. Read every 30 seconds from the platform's table, so the numbers are the same after a restart. Each Break: GET /v1/breaks.",
  "tags": [
    "b2b-payments"
  ],
  "editable": true,
  "schemaVersion": 39,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "1m",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Open Breaks",
      "description": "Every Break still OPEN, of every kind and age.",
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(max by (kind, age) (reconciliation_breaks_open{}))",
          "legendFormat": "open",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 2,
      "type": "bargauge",
      "title": "Open Breaks by kind",
      "description": "Each kind is one way a record didn't match (M4 design, \"Kinds of Break\"). Every instance of the platform reports the same table, so the panel takes one instance's figure, not their sum.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 4,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (kind) (max by (kind, age) (reconciliation_breaks_open{}))",
          "legendFormat": "{{kind}}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 3,
      "type": "bargauge",
      "title": "Open Breaks by age",
      "description": "How long ago each open Break was raised: under 1 day, 1 to 7 days, over 7 days. A Break never closes by itself, so one over 7 days old has waited a week for a Reconciler.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(max by (kind, age) (reconciliation_breaks_open{age=\"under_1_day\"}))",
          "legendFormat": "under 1 day",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(max by (kind, age) (reconciliation_breaks_open{age=\"1_to_7_days\"}))",
          "legendFormat": "1 to 7 days",
          "instant": true,
          "range": false
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(max by (kind, age) (reconciliation_breaks_open{age=\"over_7_days\"}))",
          "legendFormat": "over 7 days",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Open Breaks by kind over time",
      "description": "A step up is a Reconciliation run raising Breaks; a step down, Reconcilers resolving them.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 20
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (kind) (max by (kind, age) (reconciliation_breaks_open{}))",
          "legendFormat": "{{kind}}",
          "range": true
        }
      ]
    }
  ]
}
