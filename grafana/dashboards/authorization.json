{
  "uid": "authorization",
  "title": "Authorization",
  "description": "The Network's Authorize calls: how many, how fast against the 100 ms target (ADR-0010), and how they were answered.",
  "tags": [
    "b2b-payments"
  ],
  "editable": true,
  "schemaVersion": 39,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "1m",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Authorize calls per second",
      "description": "Every Authorize call authorization-service's gRPC server finished, by gRPC status; the panel shows data once the service exports to Grafana (#96). A status other than OK is a call refused before any answer, such as one without a retrieval reference number.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (grpc_status_code) (rate(grpc_server_milliseconds_count{rpc_method=\"Authorize\"}[$__rate_interval]))",
          "legendFormat": "{{grpc_status_code}}",
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Authorize latency (server side)",
      "description": "p50, p95 and p99 of authorization-service's own time to answer Authorize, from Spring gRPC's grpc.server timing; the panel shows data once the service exports to Grafana (#96). The red line is the 100 ms target the p99 must stay under (ADR-0010); the Authorization p99 alert fires when it stays above it for 5 minutes.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(grpc_server_milliseconds_bucket{rpc_method=\"Authorize\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(grpc_server_milliseconds_bucket{rpc_method=\"Authorize\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "range": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(grpc_server_milliseconds_bucket{rpc_method=\"Authorize\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Answers per second by response code",
      "description": "Every answer sent to the Network, a resend's included, by its DE 39 response code: 00 approved; 05 do not honour; 13 invalid amount; 14 invalid card; 54 expired card; 57 not permitted; 61 exceeds amount; N7 security code mismatch.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 20
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (response_code) (rate(authorization_answers_total[$__rate_interval]))",
          "legendFormat": "{{response_code}}",
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "type": "bargauge",
      "title": "Answers by response code in the time range",
      "description": "How many answers carried each response code over the dashboard's time range.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (response_code) (round(increase(authorization_answers_total[$__range])))",
          "legendFormat": "{{response_code}}",
          "instant": true,
          "range": false
        }
      ]
    }
  ]
}
