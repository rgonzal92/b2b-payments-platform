{
  "uid": "clearing",
  "title": "Clearing",
  "description": "Clearing Files from the Network: which were imported or refused, how their Clearings matched, and whether each file's Settlement agreed with its posted Clearings.",
  "tags": [
    "b2b-payments"
  ],
  "editable": true,
  "schemaVersion": 39,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "panels": [
    {
      "id": 1,
      "type": "bargauge",
      "title": "Clearing Files in the time range",
      "description": "imported: every Clearing recorded and the file settled. refused: it failed a check and posted nothing (it waits in failed/). repeated: it repeats a file already imported, by file ID or content.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (result) (round(increase(clearing_files_total[$__range])))",
          "legendFormat": "{{result}}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 2,
      "type": "bargauge",
      "title": "Clearings by outcome in the time range",
      "description": "How each Clearing of the imported files matched its card's Authorization. Every outcome but MATCHED becomes a Break in M4's Reconciliation.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (outcome) (round(increase(clearing_clearings_total[$__range])))",
          "legendFormat": "{{outcome}}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 3,
      "type": "bargauge",
      "title": "Settlements in the time range",
      "description": "matched: the Network's net settlement amount equals the file's posted Clearings. mismatched: the Issuer paid the Network's figure anyway, and the gap waits on the Network Settlement Payable (docs/runbooks/settlement-mismatched.md).",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(round(increase(clearing_settlements_total{matched=\"true\"}[$__range])))",
          "legendFormat": "matched",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(round(increase(clearing_settlements_total{matched=\"false\"}[$__range])))",
          "legendFormat": "mismatched",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Clearings per hour by outcome",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 20
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "3600 * sum by (outcome) (rate(clearing_clearings_total[$__rate_interval]))",
          "legendFormat": "{{outcome}}",
          "range": true
        }
      ]
    }
  ]
}
