<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>dev.rgonz.payments</groupId>
		<artifactId>b2b-payments-platform</artifactId>
		<version>0.0.1-SNAPSHOT</version>
	</parent>
	<artifactId>e2e</artifactId>
	<name>e2e</name>
	<description>The end-to-end tests: the platform and the simulator in one JVM, authorization-service beside them. No main code.</description>

	<dependencies>
		<dependency>
			<groupId>dev.rgonz.payments</groupId>
			<artifactId>platform</artifactId>
			<version>${project.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>dev.rgonz.payments</groupId>
			<artifactId>simulator</artifactId>
			<version>${project.version}</version>
			<scope>test</scope>
		</dependency>
		<!-- Runs as its own process from its executable jar (authorizationServiceJar below), so it adds nothing to this
		     classpath: as a pom with none of its dependencies, it only makes the reactor build the service first, -am included. -->
		<dependency>
			<groupId>dev.rgonz.payments</groupId>
			<artifactId>authorization-service</artifactId>
			<version>${project.version}</version>
			<type>pom</type>
			<scope>test</scope>
			<exclusions>
				<exclusion>
					<groupId>*</groupId>
					<artifactId>*</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-kafka</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.github.dasniko</groupId>
			<artifactId>testcontainers-keycloak</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<testResources>
			<!-- The realm file Keycloak imports in development, so the test runs against that same file. -->
			<testResource>
				<directory>${project.basedir}/../keycloak</directory>
				<targetPath>keycloak</targetPath>
			</testResource>
		</testResources>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<systemPropertyVariables>
						<authorizationServiceJar>${project.basedir}/../authorization-service/target/authorization-service-${project.version}-exec.jar</authorizationServiceJar>
					</systemPropertyVariables>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
